{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../database/setupDatabase.js && npx --yes concurrently -k \"node ../backend/server.js\" \"next dev\"",
    "backend": "cd ../backend && npm run dev",
    "frontend": "cd ../frontend && next dev",
    "setup": "cd ../database && node setupDatabase.js",
    "start": "next start",
    "build": "next build",
    "nodemon": "nodemon ../backend/server.js",
    "test": "jest"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcrypt": "^6.0.0",
    "concurrently": "^9.1.2",
    "cypress": "^14.4.1",
    "link": "^2.1.1",
    "next": "^16.0.8",
    "nodemon": "^3.1.9",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "xvfb": "^0.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/eslintrc": "^3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.1.6",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "@testing-library/jest-dom"
    ],
    "moduleNameMapper": {
      "\\.(css|scss)$": "identity-obj-proxy"
    }
  }
}
