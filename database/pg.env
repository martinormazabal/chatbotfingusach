# Evita sockets /tmp/postgres: fuerza TCP local
export PGHOST=127.0.0.1

# Preferido y fallback
export PGPORT_PRIMARY=5432
export PGPORT_FALLBACK=5433
export PGUSER=postgres
export PGDATABASE=postgres

# Cluster local dentro de /database
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PGDATA="$here/.pgdata"

# Puerto preferido (pg-up decidirá fallback si está ocupado)
export PGPORT="${PGPORT_PRIMARY}"